		"url": "git+https://github.com/hunterhogan/oeisTypeset.git"
	},
	"bugs": {
		"url": "https://github.com/hunterhogan/oeisTypeset/issues"
	},
	"dependencies": {
		"temml": "0.13.5"
	},
	"private": true
}
